DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
OLLAMA_URL=http://127.0.0.1:8080
EMBEDDING_MODEL=embeddinggemma
CHAT_MODEL=gemma4:e2b-it-qat
RAG_TOP_K=3
RAG_CANDIDATES=15
RAG_MIN_SIMILARITY=0.30
RERANK_ENABLED=true
MMR_LAMBDA=0.72
MAX_RETRIEVAL_CONTEXT_CHARS=12000
SUMMARY_MAX_CHUNKS=12
OLLAMA_KEEP_ALIVE=30m
WARM_MODELS=true
MAX_HISTORY_MESSAGES=5
MAX_HISTORY_CHARS=3200
ANSWER_CACHE_TTL_SECONDS=86400
RAG_PIPELINE_VERSION=3
GOOGLE_DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/105kcn3EBPbTF8Iy5JkWudlG7FUMmeGps
MAX_UPLOAD_MB=25
RAG_API_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE
REQUIRE_API_KEY=true
RUN_MIGRATIONS=true
MAX_QUEUED_REQUESTS=5
QUEUE_WAIT_SECONDS=180
REQUEST_TIMEOUT_SECONDS=360
# Per-process sliding-window limit for authenticated /v1 requests. Set requests to 0 to disable.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Keep blank when FastAPI serves the frontend. For local Vite development use:
# ALLOWED_ORIGINS=http://127.0.0.1:5173
# For production use the exact HTTPS frontend origin; wildcards are rejected.
ALLOWED_ORIGINS=
# Optional Host-header allowlist. Production example: 127.0.0.1,localhost,rag.example.com
ALLOWED_HOSTS=
PUBLIC_BASE_URL=http://127.0.0.1:8000
# OCR_PYTHON=C:\full\path\to\.venv-ocr\Scripts\python.exe
OCR_MAX_SIDE=2600
LOG_LEVEL=INFO
